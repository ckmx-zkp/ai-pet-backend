# 复制为 .env 后按需修改；.env 不进仓

# 数据库（SQLAlchemy async URL，asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_pet

# Redis（首版仅缓存）
REDIS_URL=redis://localhost:6379/0

# 用户 JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 服务间 token（/internal/* 与 memory-mcp 鉴权）
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# 外部 LLM API（agent-worker 摘要/记忆候选用，占位）
LLM_API_KEY=

# 日志
LOG_LEVEL=INFO
SERVICE_NAME=web-api
