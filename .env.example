# 复制为 .env 后按需修改；.env 不进仓

# 数据库（SQLAlchemy async URL，asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_pet

# Redis（首版仅缓存）
REDIS_URL=redis://localhost:6379/0

# 用户 JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 服务间 token（/internal/* 与 memory-mcp 鉴权）
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# 外部 LLM API（agent-worker 摘要/记忆候选/人设建议；OpenAI Chat Completions 兼容）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
# 测试期开启后，LLM 自动审核通过的人设建议会写入设备私有 overrides；默认关闭。
LLM_AUTO_APPLY_PERSONA_GROWTH=false

# Memory MCP: deployment uses streamable-http; local command defaults to stdio.
MEMORY_MCP_TRANSPORT=stdio
MEMORY_MCP_HOST=0.0.0.0
MEMORY_MCP_PORT=8000

# 日志
LOG_LEVEL=INFO
SERVICE_NAME=web-api

# CORS 允许来源（逗号分隔），生产填管理台域名，如 https://admin.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
